// ============================================================================
// ПРИМЕР 3: Учим битовую нейросеть понимать числа и показания датчиков
// ============================================================================
// ЗАДАЧА ИЗ ЖИЗНИ:
// Обычные двоичные числа плохи для сравнения: 7 (0111) и 8 (1000) отличаются
// во всех битах сразу. Поэтому мы превращаем число в «градусник» (thermometer64):
// чем больше число, тем выше столбик из единиц. Теперь нейросеть за 1 такт
// процессора видит, что температура 15°C и 17°C — это почти одно и то же!
// ============================================================================

// @file examples/03_vision_256.bc
// @brief Пример 3: Термометрическое кодирование аналоговых датчиков и классификация.

import "../std/learn.bc";
import "../std/sys.bc";
import "../std/encode.bc";

fn main() {
    // Кодируем показания двух датчиков (например, температура=15 и давление=50)
    sensorLow:  bvec<64> = thermometer64(15);
    sensorHigh: bvec<64> = thermometer64(50);

    // Похожее показание с шумом (температура=17 вместо 15)
    noisyLow:   bvec<64> = thermometer64(17);

    // Проверяем сходство через XNOR + POPCNT:
    // 15 и 17 должны совпасть в 62 битах из 64!
    simClose: int = count(match(sensorLow, noisyLow));
    simFar:   int = count(match(sensorLow, sensorHigh));

    print simClose; // Ожидаем 62
    print simFar;   // Ожидаем 29
}
