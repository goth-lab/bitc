// File: examples/07_benchmark_hdc.bc
// Description: Human-readable nanosecond latency & throughput benchmarks for BIT-C.

import "../std/sys.bc";
import "../std/learn.bc";

// MARK: - Two-Layer Binary Network (From Original model.bc)

fn forward_2layer(in_vec: bvec<256>, w1: *bvec<256>, w2: *bvec<8>) -> bvec<4> {
    hidden: bvec<8> = 0;
    for i in 0..8 {
        if count(match(in_vec, w1[i])) > 165 {
            hidden[i] = 1;
        }
    }
    decision: bvec<4> = 0;
    for j in 0..4 {
        if count(match(hidden, w2[j])) > 5 {
            decision[j] = 1;
        }
    }
    return decision;
}

// MARK: - Benchmark Runner

fn main() {
    iters: int = 10000000;

    // 1. 256-bit XNOR + POPCNT
    a256: bvec<256> = rand_mask256();
    b256: bvec<256> = ~a256;
    sink: int = 0;

    t0: int = now_ns();
    for i in 0..iters {
        bit_pos: int = i & 63;
        a256[bit_pos] = 1 - a256[bit_pos];
        sink = sink + count(match(a256, b256));
    }
    t1: int = now_ns();
    print_bench(1, iters, t1 - t0);

        // 2. 1024-bit XNOR + POPCNT
    a1024: bvec<1024>;
    b1024: bvec<1024>;
    b1024 = ~a1024;

    t2: int = now_ns();
    for j in 0..iters {
        bit_pos1024: int = j & 1023;
        a1024[bit_pos1024] = 1 - a1024[bit_pos1024];
        sink = sink + count(match(a1024, b1024));
    }
    t3: int = now_ns();
    print_bench(2, iters, t3 - t2);

    // 3. Full 2-layer binary neural network inference (1,000,000 forward passes)
    net_iters: int = 1000000;
    w1: bvec<256>[8];
    w2: bvec<8>[4];
    for k in 0..8 { w1[k] = rand_mask256(); }
    for m in 0..4 { w2[m] = 0xAA; }

    idx0: int = 0;
    t4: int = now_ns();
    for n in 0..net_iters {
        bit_pos256: int = n & 255;
        a256[bit_pos256] = 1 - a256[bit_pos256];
        out: bvec<4> = forward_2layer(a256, &w1[idx0], &w2[idx0]);
        sink = sink + out;
    }
    t5: int = now_ns();
    print_bench(3, net_iters, t5 - t4);

    if sink == -1 { print sink; }
}
