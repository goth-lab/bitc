// File: tests/tensor_test.bc
// Description: Unit tests for std/tensor.bc (zero-copy views, Q16 quantization, binarization).

import "../std/test.bc";
import "../std/tensor.bc";

// MARK: - Unit Tests for std/tensor

test "TensorView1D zero-copy slicing and TensorView2D strided access" {
    buf: i32[6];
    for i in 0..6 {
        buf[i] = (i + 1) * 10;
    }

    v1: TensorView1D<i32>;
    v1.data = &buf[0];
    v1.len = 6;

    sub: TensorView1D<i32> = v1.slice(2, 3);
    assert_eq(sub.len, 3, 1);
    assert_eq(sub.data[0], 30, 2);
    assert_eq(sub.data[2], 50, 3);

    // Interpret 6 elements as 2x3 matrix with stride 3
    mat: TensorView2D<i32>;
    mat.data = &buf[0];
    mat.rows = 2;
    mat.cols = 3;
    mat.stride = 3;
    assert_eq(mat.at(1, 2), 60, 4);
}

test "quantize_i32_to_i8 clamping and binarize_i8_to_bvec64" {
    src_arr: i32[4];
    dst_arr: i8[4];
    src_arr[0] = -500;
    src_arr[1] = -10;
    src_arr[2] = 25;
    src_arr[3] = 900;

    src_v: TensorView1D<i32>;
    src_v.data = &src_arr[0];
    src_v.len = 4;

    dst_v: TensorView1D<i8>;
    dst_v.data = &dst_arr[0];
    dst_v.len = 4;

    // Scale 1.0 in Q16.16 = 65536
    n: int = quantize_i32_to_i8(src_v, dst_v, 65536);
    assert_eq(n, 4, 10);
    assert_eq(dst_arr[0], -128, 11);
    assert_eq(dst_arr[1], -10, 12);
    assert_eq(dst_arr[2], 25, 13);
    assert_eq(dst_arr[3], 127, 14);

    hv: bvec<64> = binarize_i8_to_bvec64(dst_v, 0);
    assert_popcount<64>(hv, 2, 15);
}
