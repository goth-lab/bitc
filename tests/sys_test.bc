import "test.bc";
import "../std/sys.bc";

// MARK: - Unit Tests for std/sys

test "now_ns monotonic clock increases or stays non-negative" {
    t1: int = now_ns();
    t2: int = now_ns();
    assert_true(t1 > 0, 1);
    assert_true(t2 >= t1, 2);
}

test "rand_mask256 produces non-zero sparse hypervector" {
    m: bvec<256> = rand_mask256();
    ones: int = count(m);
    assert_true(ones > 0, 10);
    assert_true(ones < 128, 11);
}