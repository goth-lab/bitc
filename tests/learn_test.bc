import "test.bc";
import "../std/learn.bc";

// MARK: - Unit Tests for std/learn

test "nudge reinforces and weakens agreement on bvec<64>" {
    w: bvec<64> = 0x0000000000000000;
    inp: bvec<64> = 0x00000000000000FF;
    full_mask: bvec<64> = 0xFFFFFFFFFFFFFFFF;

    // Reinforce agreement: w must adopt inp bits under full_mask.
    nudge<64>(&w, inp, 1, full_mask);
    assert_eq(count(match(w, inp)), 64, 1);

    // Push apart: w must invert away from inp under full_mask.
    nudge<64>(&w, inp, 0, full_mask);
    assert_eq(count(match(w, inp)), 0, 2);
}