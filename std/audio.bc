// File: std/audio.bc
// Description: FPU-free integer PCM audio processing, VAD, ZCR, and 64-bit HDC audio encoding.

// MARK: - Zero-Copy PCM Audio Frame

/// @brief Non-owning view over 16-bit signed PCM audio samples.
struct AudioFrame16 {
    samples: *i16;
    len: int;
    sample_rate: int;
}

/// @brief Computes mean absolute amplitude (L1 energy) without floating-point math.
/// @param frame Input AudioFrame16 view.
/// @return Mean absolute sample amplitude (0..32768).
fn audio_mean_abs(frame: AudioFrame16) -> int {
    if frame.samples == 0 { return 0; }
    if frame.len <= 0 { return 0; }
    acc: int = 0;
    for i in 0..frame.len {
        s: int = frame.samples[i];
        if s < 0 {
            s = -s;
        }
        acc = acc + s;
    }
    return acc / frame.len;
}

/// @brief Voice Activity Detector (VAD) comparing frame L1 energy against `threshold`.
/// @param frame Input AudioFrame16 view.
/// @param threshold Minimum mean absolute amplitude indicating active speech/sound.
/// @return 1 if voice/sound activity is detected, 0 for silence.
fn audio_vad(frame: AudioFrame16, threshold: int) -> int {
    if audio_mean_abs(frame) >= threshold {
        return 1;
    }
    return 0;
}

/// @brief Computes Zero-Crossing Rate (ZCR) scaled in Q16.16 fixed-point (0..65536).
/// @param frame Input AudioFrame16 view (requires len >= 2).
/// @return Sign-change ratio multiplied by 65536.
fn audio_zcr_q16(frame: AudioFrame16) -> int {
    if frame.samples == 0 { return 0; }
    if frame.len < 2 { return 0; }
    crossings: int = 0;
    for i in 1..frame.len {
        prev: int = frame.samples[i - 1];
        curr: int = frame.samples[i];
        if prev >= 0 {
            if curr < 0 { crossings = crossings + 1; }
        } else {
            if curr >= 0 { crossings = crossings + 1; }
        }
    }
    return (crossings * 65536) / (frame.len - 1);
}

/// @brief Encodes an audio frame into a 64-bit temporal energy profile hypervector.
/// @param frame Input AudioFrame16 view (must have len >= 64).
/// @return 64-bit hypervector where bit `b` is 1 if sub-window `b` exceeds mean frame energy.
fn encode_audio_64(frame: AudioFrame16) -> bvec<64> {
    out: bvec<64> = 0;
    if frame.samples == 0 { return out; }
    if frame.len < 64 { return out; }

    mean_lvl: int = audio_mean_abs(frame);
    win_size: int = frame.len / 64;
    for b in 0..64 {
        sub_acc: int = 0;
        start: int = b * win_size;
        for j in 0..win_size {
            s: int = frame.samples[start + j];
            if s < 0 { s = -s; }
            sub_acc = sub_acc + s;
        }
        if (sub_acc / win_size) > mean_lvl {
            out[b] = 1;
        }
    }
    return out;
}
