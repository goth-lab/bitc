// MARK: - Discrete On-Device Weight Update Primitives

/// @brief Performs stochastic bitwise weight nudging without floating-point math.
/// @tparam N Bit-width of the weight and input hypervectors.
/// @param weight Pointer to the target synaptic weight vector to update in-place.
/// @param input Input feature hypervector.
/// @param wantFire Target firing state (1 to reinforce agreement, 0 to push apart).
/// @param mask Sparse stochastic learning-rate mask controlling which bits flip.
fn nudge<N>(weight: *bvec<N>, input: bvec<N>, wantFire: bit, mask: bvec<N>) {
    if wantFire == 1 {
        *weight = *weight ^ ((*weight ^ input) & mask);
    } else {
        *weight = *weight ^ (~(*weight ^ input) & mask);
    }
}
