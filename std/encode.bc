// @file std/encode.bc
// @brief Стандартная библиотека кодирования сигналов и пикселей в битовые векторы.

// Преобразует аналоговое число val (0..64) в 64-битный термометрический код.
// Похожие числа имеют почти одинаковые битовые маски (идеально для match).
fn thermometer64(val: int) -> bvec<64> {
    out: bvec<64> = 0;
    limit: int = val;
    if limit > 64 {
        limit = 64;
    }
    for i in 0..limit {
        out[i] = 1;
    }
    return out;
}
