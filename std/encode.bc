// MARK: - Scalar & Sensor Hyperdimensional Encoders

/// @brief Encodes an integer scalar (0..64) into a 64-bit thermometer code.
/// @param val Input scalar value (clamped to the [0, 64] range).
/// @return 64-bit hypervector with the lowest `val` bits set to 1.
/// @note Preserves locality: nearby numbers share high XNOR match() popcount.
fn thermometer64(val: int) -> bvec<64> {
    out: bvec<64> = 0;
    limit: int = val;
    if limit < 0 {
        limit = 0;
    }
    if limit > 64 {
        limit = 64;
    }
    for i in 0..limit {
        out[i] = 1;
    }
    return out;
}
