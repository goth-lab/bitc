// MARK: - External C Runtime System Primitives

/// @brief Generates a sparse 64-bit random mask (~12.5% set bits) via Xorshift64*.
/// @return 64-bit sparse hypervector mask.
extern fn rand_mask() -> bvec<64>;

/// @brief Reads the monotonic system clock in nanoseconds.
/// @return Elapsed monotonic time in nanoseconds.
extern fn now_ns() -> int;

/// @brief Persists raw binary memory to a numbered weight slot file on disk.
/// @param slot Numeric slot identifier (creates weights_slot_<slot>.bin).
/// @param ptr Pointer to the source memory buffer.
/// @param bytes Number of bytes to write.
extern fn save_raw(slot: int, ptr: *void, bytes: int);

/// @brief Loads raw binary memory from a numbered weight slot file on disk.
/// @param slot Numeric slot identifier (reads weights_slot_<slot>.bin).
/// @param ptr Pointer to the destination memory buffer.
/// @param bytes Number of bytes to read.
extern fn load_raw(slot: int, ptr: *void, bytes: int);

/// @brief Prints a formatted integer-only nanosecond latency and throughput benchmark report.
/// @param id Numeric benchmark stage identifier.
/// @param iterations Total number of executed loop iterations.
/// @param elapsed_ns Total elapsed monotonic time in nanoseconds.
extern fn print_bench(id: int, iterations: int, elapsed_ns: int);

// MARK: - Wide Hypervector Random Generators

/// @brief Generates a sparse 256-bit random mask by populating each bit lane.
/// @return 256-bit sparse hypervector mask.
/// @note Uses bit-level indexing unlocked in BIT-C v1.1 codegen.
fn rand_mask256() -> bvec<256> {
    res: bvec<256>;
    for w in 0..4 {
        chunk: bvec<64> = rand_mask();
        base: int = w * 64;
        for b in 0..64 {
            idx: int = base + b;
            res[idx] = chunk[b];
        }
    }
    return res;
}
